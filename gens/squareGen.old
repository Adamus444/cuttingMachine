"""
Generate a G-code file for a hot-wire cutter that cuts a grid of squares.
Pure 2D (X/Y only) - no Z axis, no laser/spindle control.

Adjust the VARIABLES section below to change:
- square size
- spacing between squares
- number of rows/columns
- feed rate (cutting speed) and travel (rapid) speed
- origin offset

Between squares the wire travels at TRAVEL_RATE with G1 (not G0), since a
hot wire is always "on" and a straight-line rapid move would just melt a
line through the material. If your controller/setup allows truly safe
non-cutting rapids (e.g. wire retracts, material lifts, etc.), change the
travel moves to G0 instead.

Run:
    python grid_squares_gcode.py
Output:
    grid_squares.gcode
"""

# ---------------- VARIABLES ----------------
SQUARE_SIZE = 20.0       # mm, size of each square (width = height)
ROWS = 3                 # number of rows of squares
COLS = 3                 # number of columns of squares

FEED_RATE = 300          # mm/min, speed while cutting the square outline

ORIGIN_X = 0.0           # mm, X offset for the whole grid
ORIGIN_Y = 0.0           # mm, Y offset for the whole grid

OUTPUT_FILE = "squares.gcode"
# --------------------------------------------


def generate_gcode():
    lines = []
    #lines.append("; Grid of squares - generated by grid_squares_gcode.py")
    lines.append("; 2D hot-wire cutting, X/Y only")
    lines.append("G21 ; units = mm")
    lines.append("G90 ; absolute positioning")

    current_pos = (ORIGIN_X, ORIGIN_Y)

    #lines.append(f"G1 X{current_pos[0]:.3f} Y{current_pos[1]:.3f} F{TRAVEL_RATE} ; move to start")

    for row in range(ROWS):
        y0 = ORIGIN_Y + row * SQUARE_SIZE
        y1 = y0 + SQUARE_SIZE
        for col in range(COLS):
            x0 = ORIGIN_X + col * SQUARE_SIZE
            x1 = x0 + SQUARE_SIZE

            lines.append(f"; --- square row {row}, col {col} ---")

            # Travel move from wherever we are to the square's start corner
            #lines.append(f"G1 X{x0:.3f} Y{y0:.3f} F{TRAVEL_RATE}")

            # Cut the four sides of the square
            lines.append(f"G1 X{x0:.3f} Y{y1:.3f} F{FEED_RATE}")
            lines.append(f"G1 X{x1:.3f} Y{y1:.3f} F{FEED_RATE}")
            lines.append(f"G1 X{x1:.3f} Y{y0:.3f} F{FEED_RATE}")
            lines.append(f"G1 X{x1:.3f} Y{y1:.3f} F{FEED_RATE}")

            current_pos = (x0, y0)

        lines.append(f"G1 X0 Y{y1:.3f} F{FEED_RATE}")
    #lines.append(f"G1 X{ORIGIN_X:.3f} Y{ORIGIN_Y:.3f} F{TRAVEL_RATE} ; return to origin")
    lines.append("M2 ; end of program")

    return "\n".join(lines)


if __name__ == "__main__":
    gcode = generate_gcode()
    with open(OUTPUT_FILE, "w") as f:
        f.write(gcode)
    print(f"G-code written to {OUTPUT_FILE}")
    print(f"{ROWS * COLS} squares, size {SQUARE_SIZE}mm, feed rate {FEED_RATE}mm/min")
